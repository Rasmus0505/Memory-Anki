{"openapi": "3.1.0", "info": {"title": "Memory Anki API", "version": "0.1.0"}, "paths": {"/api/v1/dashboard/learning-progress": {"get": {"tags": ["dashboard"], "summary": "Api Learning Progress", "operationId": "api_learning_progress_api_v1_dashboard_learning_progress_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LearningProgressResponse"}}}}}}}}, "components": {"schemas": {"LearningProgressResponse": {"properties": {"roots": {"items": {"$ref": "#/components/schemas/LearningProgressNode"}, "type": "array", "title": "Roots"}, "metrics": {"$ref": "#/components/schemas/LearningProgressMetrics"}, "generated_at": {"type": "string", "title": "Generated At"}, "notes": {"items": {"type": "string"}, "type": "array", "title": "Notes"}}, "type": "object", "required": ["roots", "metrics", "generated_at", "notes"], "title": "LearningProgressResponse"}, "LearningProgressNode": {"properties": {"id": {"type": "string", "title": "Id"}, "name": {"type": "string", "title": "Name"}, "kind": {"type": "string", "enum": ["subject", "palace", "chapter", "unit", "memory_point"], "title": "Kind"}, "palace_id": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Palace Id"}, "children": {"items": {"$ref": "#/components/schemas/LearningProgressNode"}, "type": "array", "title": "Children"}, "metrics": {"$ref": "#/components/schemas/LearningProgressMetrics"}}, "type": "object", "required": ["id", "name", "kind", "palace_id", "children", "metrics"], "title": "LearningProgressNode"}, "LearningProgressMetrics": {"properties": {"memory_total": {"type": "integer", "minimum": 0.0, "title": "Memory Total"}, "memory_reviewed": {"type": "integer", "minimum": 0.0, "title": "Memory Reviewed"}, "memory_due": {"type": "integer", "minimum": 0.0, "title": "Memory Due"}, "quiz_total": {"type": "integer", "minimum": 0.0, "title": "Quiz Total"}, "quiz_answered": {"type": "integer", "minimum": 0.0, "title": "Quiz Answered"}}, "type": "object", "required": ["memory_total", "memory_reviewed", "memory_due", "quiz_total", "quiz_answered"], "title": "LearningProgressMetrics"}}}}